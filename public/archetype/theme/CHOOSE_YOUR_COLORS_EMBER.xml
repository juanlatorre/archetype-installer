<?xml version="1.0" encoding="UTF-8"?><themes>
    <!-- CHOOSE YOUR COLORS! Replace the hex code between the color></color> tags with a different value.
    Refer to the CHOOSE_YOUR_COLORS_GUIDE.png for examples of defined areas. -->

    <!-- Ember -->

    <!-- Main Colors -->
    <!-- Title bar and window outline -->
    <constantDef name="main-color"><color>#B44527</color></constantDef>
    <!-- Background -->
    <constantDef name="sub-color"><color>#121010</color></constantDef>
    <!-- Buttons -->
    <constantDef name="button-color"><color>#1F1816</color></constantDef>
    <!-- Outlines -->
    <constantDef name="accent-color"><color>#4A170F</color></constantDef>

    <!-- Font Colors -->
    <!-- Font color on top of main-color -->
    <constantDef name="font-main-color"><color>#F7E7D1</color></constantDef>
    <!-- Font color on top of sub-color -->
    <constantDef name="font-sub-color"><color>#D4B9A5</color></constantDef>
    <!-- Font color on top of button-color -->
    <constantDef name="font-button-color"><color>#F7E7D1</color></constantDef>
    <!-- Font color for a disabled button -->
    <constantDef name="font-disabled-color"><color>#8A6B5B</color></constantDef>

    <!-- Bar Fill Colors -->
    <!-- HP (high) — always a shade of green -->
    <constantDef name="hp-high-color"><color>#39B05A</color></constantDef>
    <!-- HP (mid) — always a shade of yellow -->
    <constantDef name="hp-mid-color"><color>#E2C44F</color></constantDef>
    <!-- HP (low) — always a shade of red -->
    <constantDef name="hp-low-color"><color>#D14C3C</color></constantDef>
    <!-- XP bar — always a shade of blue -->
    <constantDef name="xp-color"><color>#5B86D4</color></constantDef>
    <!-- Friendship bar — always a shade of purple or pink -->
    <constantDef name="friendship-color"><color>#E379A8</color></constantDef>

    <!-- Icon tint -->
    <constantDef name="icon-color"><color>#F7E7D1</color></constantDef>

    <!-- Berry Watering Colors -->
    <!-- Water background -->
    <constantDef name="water-background"><color>#241512</color></constantDef>
    <!-- Water warning -->
    <constantDef name="water-warning"><color>#E2C44F</color></constantDef>
    <!-- Berry progress -->
    <constantDef name="berry-progress"><color>#DF7A30</color></constantDef>
    <!-- Berry progress warning -->
    <constantDef name="berry-progress-warning"><color>#D88B54</color></constantDef>
    <!-- Disabled berry UI -->
    <constantDef name="berry-progress-disabled"><color>#4A312A</color></constantDef>

    <!-- Unova Login Screen -->
    <!-- Each -color acts as the fill for their side and the background of the opposite side, a la yin-yang. Auras should be opposites and complementary at the same time. -->
    <constantDef name="reshiram-color"><color>#1A0E0C</color></constantDef>
    <constantDef name="reshiram-aura"><color>#FF7A3C</color></constantDef>
    <constantDef name="zekrom-color"><color>#0C0706</color></constantDef>
    <constantDef name="zekrom-aura"><color>#C93F1E</color></constantDef>

    <!-- Encounter Tracker Colors: -->
    <!-- Same as sub-color -->
    <constantDef name="counter-ball-color"><color>#121010</color></constantDef>
    <!-- Same as main-color -->
    <constantDef name="counter-ball-outline"><color>#B44527</color></constantDef>
    <!-- Must contrast well with counter-main-color -->
    <constantDef name="counter-min-max-button-color"><color>#F7E7D1</color></constantDef>
    <!-- Same as main-color -->
    <constantDef name="counter-main-color"><color>#B44527</color></constantDef>
    <!-- Same as sub-color -->
    <constantDef name="counter-sub-color"><color>#121010</color></constantDef>
    <!-- Same as font-color -->
    <constantDef name="counter-font"><color>#F7E7D1</color></constantDef>
    <constantDef name="counter-font-border"><color>#0B0706</color></constantDef>

</themes>
