<?xml version="1.0" encoding="UTF-8"?><themes>
<!-- CHOOSE YOUR COLORS! Replace the hex code between the color></color> tags with a different value.
Refer to the CHOOSE_YOUR_COLORS_GUIDE.png for examples of defined areas. -->

<!-- Sunrise -->

<!-- Main Theme -->
<!-- Title bar and window outline -->
<constantDef name="main-color"><color>#D98742</color></constantDef>
<!-- Background -->
<constantDef name="sub-color"><color>#EAE3D2</color></constantDef>
<!-- Buttons -->
<constantDef name="button-color"><color>#DFE6D7</color></constantDef>
<!-- Outlines -->
<constantDef name="accent-color"><color>#aac17d</color></constantDef>

<!-- Font Colors -->
<!-- Font color on top of main-color -->
<constantDef name="font-main-color"><color>#1E1A12</color></constantDef>
<!-- Font color on top of sub-color -->
<constantDef name="font-sub-color"><color>#5C4F2B</color></constantDef>
<!-- Font color on top of button-color -->
<constantDef name="font-button-color"><color>#1E1A12</color></constantDef>
<!-- Font color for a disabled button -->
<constantDef name="font-disabled-color"><color>#9B8F70</color></constantDef>

<!-- Bar Fill Colors -->
<!-- HP (high) — always a shade of green -->
<constantDef name="hp-high-color"><color>#2EBA4A</color></constantDef>
<!-- HP (mid) — always a shade of yellow -->
<constantDef name="hp-mid-color"><color>#E5CF58</color></constantDef>
<!-- HP (low) — always a shade of red -->
<constantDef name="hp-low-color"><color>#D35C43</color></constantDef>
<!-- XP bar — always a shade of blue -->
<constantDef name="xp-color"><color>#4A7FBF</color></constantDef>
<!-- Friendship bar — always a shade of purple or pink -->
<constantDef name="friendship-color"><color>#E86AA2</color></constantDef>

<!-- Icon tint -->
<constantDef name="icon-color"><color>#1E1A12</color></constantDef>

<!-- Berry Watering Colors -->
<!-- Water background -->
<constantDef name="water-background"><color>#DCE4DE</color></constantDef>
<!-- Water warning -->
<constantDef name="water-warning"><color>#B78C2E</color></constantDef>
<!-- Berry progress -->
<constantDef name="berry-progress"><color>#3AAE59</color></constantDef>
<!-- Berry progress warning -->
<constantDef name="berry-progress-warning"><color>#C97A3A</color></constantDef>
<!-- Disabled berry UI -->
<constantDef name="berry-progress-disabled"><color>#C5CAC6</color></constantDef>

<!-- Unova Login Screen -->
<!-- Each -color acts as the fill for their side and the background of the opposite side, a la yin-yang. Auras should be opposites and complementary at the same time. -->
<constantDef name="reshiram-color"><color>#C8B37A</color></constantDef>
<constantDef name="reshiram-aura"><color>#B289D8</color></constantDef>
<constantDef name="zekrom-color"><color>#8CA7BB</color></constantDef>
<constantDef name="zekrom-aura"><color>#A5D889</color></constantDef>

<!-- Encounter Tracker Colors: -->
<!-- Same as sub-color -->
<constantDef name="counter-ball-color"><color>#EAE3D2</color></constantDef>
<!-- Same as main-color -->
<constantDef name="counter-ball-outline"><color>#D98742</color></constantDef>
<!-- Must contrast well with counter-main-color -->
<constantDef name="counter-min-max-button-color"><color>#1E1A12</color></constantDef>
<!-- Same as main-color -->
<constantDef name="counter-main-color"><color>#D98742</color></constantDef>
<!-- Same as sub-color -->
<constantDef name="counter-sub-color"><color>#EAE3D2</color></constantDef>
<!-- Same as font-color -->
<constantDef name="counter-font"><color>#1E1A12</color></constantDef>
<constantDef name="counter-font-border"><color>#101E1A12</color></constantDef>

</themes>
