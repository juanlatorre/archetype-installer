<?xml version="1.0" encoding="UTF-8"?><themes>
    <!-- CHOOSE YOUR COLORS! Replace the hex code between the color></color> tags with a different value.
    Refer to the CHOOSE_YOUR_COLORS_GUIDE.png for examples of defined areas. -->

    <!-- Industrial -->

    <!-- Main Colors -->
    <!-- Title bar and window outline -->
    <constantDef name="main-color"><color>#3A444F</color></constantDef>
    <!-- Background -->
    <constantDef name="sub-color"><color>#11141A</color></constantDef>
    <!-- Buttons -->
    <constantDef name="button-color"><color>#262C34</color></constantDef>
    <!-- Outlines -->
    <constantDef name="accent-color"><color>#20262D</color></constantDef>

    <!-- Font Colors -->
    <!-- Font color on top of main-color -->
    <constantDef name="font-main-color"><color>#E0E4E8</color></constantDef>
    <!-- Font color on top of sub-color -->
    <constantDef name="font-sub-color"><color>#A4AAB0</color></constantDef>
    <!-- Font color on top of button-color -->
    <constantDef name="font-button-color"><color>#E6EBF0</color></constantDef>
    <!-- Font color for a disabled button -->
    <constantDef name="font-disabled-color"><color>#646B72</color></constantDef>

    <!-- Bar Fill Colors -->
    <!-- HP (high) — always a shade of green -->
    <constantDef name="hp-high-color"><color>#3DBA5F</color></constantDef>
    <!-- HP (mid) — always a shade of yellow -->
    <constantDef name="hp-mid-color"><color>#D3C357</color></constantDef>
    <!-- HP (low) — always a shade of red -->
    <constantDef name="hp-low-color"><color>#C94C42</color></constantDef>
    <!-- XP bar — always a shade of blue -->
    <constantDef name="xp-color"><color>#4D82C2</color></constantDef>
    <!-- Friendship bar — always a shade of purple or pink -->
    <constantDef name="friendship-color"><color>#B57BBF</color></constantDef>

    <!-- Icon tint -->
    <constantDef name="icon-color"><color>#E0E4E8</color></constantDef>

    <!-- Berry Watering Colors -->
    <!-- Water background -->
    <constantDef name="water-background"><color>#20252C</color></constantDef>
    <!-- Water warning -->
    <constantDef name="water-warning"><color>#D3C357</color></constantDef>
    <!-- Berry progress -->
    <constantDef name="berry-progress"><color>#3D6E84</color></constantDef>
    <!-- Berry progress warning -->
    <constantDef name="berry-progress-warning"><color>#C27A3E</color></constantDef>
    <!-- Disabled berry UI -->
    <constantDef name="berry-progress-disabled"><color>#3B4047</color></constantDef>

    <!-- Unova Login Screen -->
    <!-- Each -color acts as the fill for their side and the background of the opposite side, a la yin-yang. Auras should be opposites and complementary at the same time. -->
    <constantDef name="reshiram-color"><color>#8A97A3</color></constantDef>
    <constantDef name="reshiram-aura"><color>#C7D1D9</color></constantDef>
    <constantDef name="zekrom-color"><color>#1D2329</color></constantDef>
    <constantDef name="zekrom-aura"><color>#818995</color></constantDef>

    <!-- Encounter Tracker Colors: -->
    <!-- Same as sub-color -->
    <constantDef name="counter-ball-color"><color>#11141A</color></constantDef>
    <!-- Same as main-color -->
    <constantDef name="counter-ball-outline"><color>#3A444F</color></constantDef>
    <!-- Must contrast well with counter-main-color -->
    <constantDef name="counter-min-max-button-color"><color>#E0E4E8</color></constantDef>
    <!-- Same as main-color -->
    <constantDef name="counter-main-color"><color>#3A444F</color></constantDef>
    <!-- Same as sub-color -->
    <constantDef name="counter-sub-color"><color>#11141A</color></constantDef>
    <!-- Same as font-color -->
    <constantDef name="counter-font"><color>#E0E4E8</color></constantDef>
    <constantDef name="counter-font-border"><color>#050609</color></constantDef>

</themes>
